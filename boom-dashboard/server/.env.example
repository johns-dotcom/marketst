DATABASE_URL=postgresql://user:pass@localhost:5432/marketst_dashboard
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gmail API (OAuth2) — used for transactional emails
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Encryption key for stored vendor payment details (account / routing / IBAN).
# 32 bytes, hex or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED. Without it POST /api/vendor/submit refuses every submission with a
# 503 rather than storing bank details in plain text or silently dropping them —
# see server/lib/payment-crypto.js. Set it BEFORE deploying that change.
#
# Losing this key makes every stored account number unreadable (the invoice PDFs
# still hold them). Keep a copy somewhere durable.
PAYMENT_DETAILS_KEY=
