# Copy this file to .env.local and fill in your values.
# VITE_BK_URL tells the React app where the Flask bookkeeping app is running.

# Local development (Flask default port)
VITE_BK_URL=http://localhost:5000

# Production example (replace with your deployed Flask URL)
# VITE_BK_URL=https://boom-invoices.up.railway.app
